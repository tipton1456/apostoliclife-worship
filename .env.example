# Planning Center Online
PCO_CLIENT_ID=your_pco_client_id
PCO_SECRET=your_pco_secret
PCO_SUNDAY_AM_SERVICE_TYPE_ID=1636095
PCO_SUNDAY_PM_SERVICE_TYPE_ID=1636099
PCO_WORSHIP_TEAM_NAME=Worship Team

# Mic board web app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000

# PreSonus bridge (used by mic board in the browser)
NEXT_PUBLIC_PRESONUS_BRIDGE_URL=http://localhost:4310

# PreSonus mixer connection (used by the bridge service)
PRESONUS_HOST=192.168.1.123
PRESONUS_PORT=53000
PRESONUS_BRIDGE_PORT=4310
PRESONUS_CHANNELS=8
PRESONUS_SIGNAL_THRESHOLD=3
PRESONUS_SIGNAL_SCALE=32
PRESONUS_HISTORY_SIZE=24

# Optional HTTPS for the bridge (leave unset to use HTTP)
# PRESONUS_BRIDGE_CERT=/absolute/path/to/cert.pem
# PRESONUS_BRIDGE_KEY=/absolute/path/to/key.pem

# Big Top Back to School Bash check-in (/big-top)
# On Vercel: create a Blob store and this token is auto-set (or paste it here).
# Locally: leave unset to use data/tithely/big-top-store.json on disk.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Optional staff password gate for /big-top APIs (recommended on public Vercel)
# BIG_TOP_ACCESS_CODE=choose-a-staff-code